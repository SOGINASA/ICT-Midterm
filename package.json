{
  "name": "tengeflow",
  "version": "1.0.0",
  "private": true,
  "description": "TengeFlow — ICT midterm personal expense tracker",
  "dependencies": {
    "@fontsource/dm-sans": "5.1.1",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "13.5.0",
    "@types/jest": "27.5.2",
    "@types/node": "16.18.126",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.2",
    "react-scripts": "5.0.1",
    "recharts": "2.15.4",
    "typescript": "4.9.5",
    "zod": "3.24.2",
    "zustand": "4.5.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "tailwindcss": "3.4.17",
    "http-proxy-middleware": "2.0.10"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "backend:start": "node scripts/local-backend.mjs start",
    "backend:stop": "node scripts/local-backend.mjs stop",
    "backend:status": "node scripts/local-backend.mjs status",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "backend:test": "node scripts/local-backend.mjs test",
    "deploy:api": "node scripts/configure-api-proxy.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
