APP_ENV=development
# Optional locally: an uncommitted secret is generated in instance/.jwt-secret.
# Production: set a unique random secret of at least 32 characters.
JWT_SECRET_KEY=
# Defaults to backend/instance/tengeflow.sqlite3; production example:
# DATABASE_URL=postgresql+psycopg://tengeflow:password@127.0.0.1:5432/tengeflow
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000
# Production requires Redis so all Gunicorn workers share rate limits.
RATELIMIT_STORAGE_URI=memory://
# No SMTP locally: email is saved to instance/outbox, /api/dev/inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
MAIL_FROM=TengeFlow <hello@tengeflow.local>
# Set only behind a trusted reverse proxy that replaces forwarded headers.
TRUSTED_PROXY_HOPS=0
