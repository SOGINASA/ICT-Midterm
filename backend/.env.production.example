APP_ENV=production
# Standalone containers use PORT. Compose fixes the internal port at 1488;
# set BACKEND_HOST_PORT in the shell to change its published loopback port.
PORT=1488
INSTANCE_PATH=/data

# Leave blank: a random signing key is generated once and saved in /data.
JWT_SECRET_KEY=

# SQLite database persisted in the Docker volume.
DATABASE_URL=sqlite:////data/tengeflow.sqlite3

FRONTEND_URL=https://ict-midterm-artyom.vercel.app
CORS_ORIGINS=https://ict-midterm-artyom.vercel.app

# In-memory limits are suitable for this single-worker container.
RATELIMIT_STORAGE_URI=memory://

# Optional SMTP credentials. Without SMTP, email registration and password reset are unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
MAIL_FROM=TengeFlow <hello@tengeflow.local>

WEB_CONCURRENCY=1

# Keep 0 unless the host's trusted proxy count is known and configured.
TRUSTED_PROXY_HOPS=0
