APP_ENV=production
PORT=1488
INSTANCE_PATH=/data

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Managed PostgreSQL URL; URL-encode special characters in username/password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/tengeflow

FRONTEND_URL=https://ict-midterm-artyom.vercel.app
CORS_ORIGINS=https://ict-midterm-artyom.vercel.app

# Managed Redis URL with TLS (rediss://) for shared rate limits.
RATELIMIT_STORAGE_URI=rediss://default:REDIS_PASSWORD@REDIS_HOST:6379/0

# SMTP credentials for verification and password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=SMTP_USERNAME
SMTP_PASSWORD=SMTP_PASSWORD
SMTP_STARTTLS=1
SMTP_SSL=0
MAIL_FROM=TengeFlow <hello@example.com>

# Keep 0 unless the host's trusted proxy count is known and configured.
TRUSTED_PROXY_HOPS=0